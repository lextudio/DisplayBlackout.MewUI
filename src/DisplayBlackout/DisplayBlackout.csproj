<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DisplayBlackout</RootNamespace>
    <AssemblyName>DisplayBlackout</AssemblyName>
    <!-- Version is computed from git tags by GitVersion (see GitVersion.yml).
         Do not hardcode AssemblyVersion/FileVersion here. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- macOS bundle metadata — single source of truth for dist.macos.sh -->
    <MacAppName>Display Blackout</MacAppName>
    <MacBundleIdentifier>com.aprillz.displayblackout</MacBundleIdentifier>
    <MacMinimumSystemVersion>13.0</MacMinimumSystemVersion>

    <!-- Language and Analysis -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <NoWarn>$(NoWarn);CA1416</NoWarn>

    <!-- AOT (publish only; re-enable JSON reflection for debug/DevFlow) -->
    <PublishAot>true</PublishAot>
    <JsonSerializerIsReflectionEnabledByDefault Condition="'$(PublishingWithAot)' != 'true'">true</JsonSerializerIsReflectionEnabledByDefault>

    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <None Remove="Resources\SEGMDL2.TTF" />
  </ItemGroup>


  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\icon.ico" LogicalName="icon.ico" />
    <EmbeddedResource Include="Assets\icon-inactive.ico" LogicalName="icon-inactive.ico" />
    <EmbeddedResource Include="Assets\icon.icns" LogicalName="icon.icns" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
    <EmbeddedResource Include="Assets\StatusActive.png" LogicalName="StatusActive.png" />
    <EmbeddedResource Include="Assets\StatusInactive.png" LogicalName="StatusInactive.png" />
    <EmbeddedResource Include="Resources\SEGMDL2.TTF" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <LinkerArg Include="-framework CoreGraphics" />
    <LinkerArg Include="-framework Carbon" />
    <LinkerArg Include="-L/opt/homebrew/opt/openssl@3/lib" />
    <LinkerArg Include="-L/opt/homebrew/opt/brotli/lib" />
  </ItemGroup>

  <ItemGroup>
    <!-- Derives Version/AssemblyVersion/FileVersion from git tags (vX.Y.Z) -->
    <PackageReference Include="GitVersion.MsBuild" Version="6.7.0" PrivateAssets="all" />
    <PackageReference Include="Aprillz.MewUI.Backend.Gdi" Version="0.15.2" />
    <PackageReference Include="Aprillz.MewUI.MacOS" Version="0.15.2" />
    <PackageReference Include="Aprillz.MewUI.Platform.Win32" Version="0.15.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <!-- DevFlow agent — debug only, NuGet package -->
    <PackageReference Include="LeXtudio.DevFlow.Agent.MewUI" Version="0.1.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- ProTranslate MewUI adapter — local project (not yet on NuGet) -->
    <ProjectReference Include="..\..\..\..\mewui-tools\ProTranslate\src\ProTranslate.MewUI\ProTranslate.MewUI.csproj" />
    <!-- SourceGenerator — NuGet package -->
    <PackageReference Include="ProTranslate.SourceGenerator" Version="0.1.0"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <!-- Translation JSON files fed to the SourceGenerator -->
  <ItemGroup>
    <AdditionalFiles Include="Resources/Strings.*.json" />
  </ItemGroup>

  <!-- Generate the macOS Info.plist from the template, stamping the GitVersion-computed
       version into the publish output. dist.macos.sh copies this into the .app bundle. -->
  <Target Name="GenerateMacInfoPlist"
          AfterTargets="Publish"
          DependsOnTargets="GetVersion"
          Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <PropertyGroup>
      <_PlistTemplate>$(MSBuildProjectDirectory)/Info.plist.template</_PlistTemplate>
      <_PlistText>$([System.IO.File]::ReadAllText('$(_PlistTemplate)'))</_PlistText>
      <_PlistText>$(_PlistText.Replace('${APP_NAME}', '$(MacAppName)'))</_PlistText>
      <_PlistText>$(_PlistText.Replace('${BUNDLE_ID}', '$(MacBundleIdentifier)'))</_PlistText>
      <_PlistText>$(_PlistText.Replace('${VERSION}', '$(GitVersion_MajorMinorPatch)'))</_PlistText>
      <_PlistText>$(_PlistText.Replace('${SHORT_VERSION}', '$(GitVersion_MajorMinorPatch)'))</_PlistText>
      <_PlistText>$(_PlistText.Replace('${EXE_NAME}', '$(AssemblyName)'))</_PlistText>
      <_PlistText>$(_PlistText.Replace('${MIN_OS}', '$(MacMinimumSystemVersion)'))</_PlistText>
    </PropertyGroup>
    <WriteLinesToFile File="$(PublishDir)Info.plist" Lines="$(_PlistText)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <Message Importance="high" Text="Generated Info.plist (version $(GitVersion_MajorMinorPatch)) at $(PublishDir)Info.plist" />
  </Target>

</Project>
